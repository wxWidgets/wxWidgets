accessbasic.app/Contents/PkgInfo: accessbasic$(EXEEXT) $(top_srcdir)/src/osx/carbon/Info.plist.in $(top_srcdir)/src/osx/carbon/wxmac.icns
	mkdir -p accessbasic.app/Contents
	mkdir -p accessbasic.app/Contents/MacOS
	mkdir -p accessbasic.app/Contents/Resources
	
	
	sed -e "s/\$${MACOSX_BUNDLE_GUI_IDENTIFIER}/org.wxwidgets.accessbasic/" \
	-e "s/\$${MACOSX_BUNDLE_EXECUTABLE_NAME}/accessbasic/" \
	-e "s/\$${MACOSX_BUNDLE_BUNDLE_NAME}/accessbasic/" \
	-e "s/\$${MACOSX_BUNDLE_COPYRIGHT}/Copyright 2002-2026 wxWidgets/" \
	-e "s/\$${MACOSX_BUNDLE_BUNDLE_VERSION}/$(WX_VERSION)/" \
	-e "s/\$${MACOSX_BUNDLE_INFO_STRING}/accessbasic version $(WX_VERSION), (c) 2002-2026 wxWidgets/" \
	-e "s/\$${MACOSX_BUNDLE_LONG_VERSION_STRING}/$(WX_VERSION), (c) 2002-2026 wxWidgets/" \
	-e "s/\$${MACOSX_BUNDLE_SHORT_VERSION_STRING}/$(WX_RELEASE)/" \
	$(top_srcdir)/src/osx/carbon/Info.plist.in >accessbasic.app/Contents/Info.plist
	
	
	/bin/echo "APPL????" >accessbasic.app/Contents/PkgInfo
	
	
	ln -f accessbasic$(EXEEXT) accessbasic.app/Contents/MacOS/accessbasic
	
	
	cp -f $(top_srcdir)/src/osx/carbon/wxmac.icns accessbasic.app/Contents/Resources/wxmac.icns

